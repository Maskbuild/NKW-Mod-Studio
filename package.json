{
  "name": "nkw-mod-studio",
  "productName": "NKW Mod Studio",
  "version": "0.2.1",
  "description": "Node-based Minecraft mod maker by Nam Kueap Wan (NKW)",
  "author": "Nam Kueap Wan (NKW)",
  "license": "Zlib",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "verify:matrix": "tsx scripts/verify-matrix.ts",
    "dist": "electron-vite build && electron-builder --win"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.0",
    "ffmpeg-static": "^5.3.0",
    "i18next": "^26.4.2",
    "immer": "^11.1.18",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "three": "^0.186.1",
    "yauzl": "^3.4.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.5.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "electron@44.5.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "ffmpeg-static@5.3.0": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Maskbuild/NKW-Mod-Studio.git"
  },
  "homepage": "https://github.com/Maskbuild/NKW-Mod-Studio"
}
