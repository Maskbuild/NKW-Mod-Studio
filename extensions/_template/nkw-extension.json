{
  "schema": 1,
  "id": "my-extension",
  "name": { "en": "My extension", "th": "ส่วนเสริมของฉัน" },
  "description": { "en": "Adds a Greeting node: the mod writes a line to the game log when it starts.", "th": "เพิ่มโหนด Greeting: ม็อดเขียนข้อความลงบันทึกของเกมตอนเริ่ม" },
  "version": "1.0.0",
  "minApp": "0.2.1",
  "categories": {
    "greetings": { "label": { "en": "Greetings", "th": "คำทักทาย" }, "color": "#14b8a6", "order": 20 }
  },
  "nodes": ["nodes/greeting.json"],
  "generate": [
    {
      "id": "greeting-class",
      "when": "len(ext.greetings) > 0",
      "emit": [{ "kind": "java", "class": "MyGreetings", "template": "templates/MyGreetings.tpl" }]
    }
  ],
  "hooks": [{ "site": "commonInit", "order": 90, "when": "len(ext.greetings) > 0", "line": "MyGreetings.init();" }]
}
